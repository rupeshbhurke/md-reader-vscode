{
  "name": "md-reader",
  "displayName": "MD Reader",
  "description": "A reading-focused, fully customizable Markdown viewer with independent multi-document support.",
  "version": "0.6.0",
  "publisher": "rupeshbhurke",
  "author": {
    "name": "Rupesh H Bhurke",
    "email": "rupeshbhurke@yahoo.com",
    "url": "https://github.com/rupeshbhurke"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rupeshbhurke/md-reader-vscode"
  },
  "bugs": {
    "url": "https://github.com/rupeshbhurke/md-reader-vscode/issues"
  },
  "homepage": "https://github.com/rupeshbhurke/md-reader-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "reader",
    "preview",
    "reading",
    "document"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdReader.open",
        "title": "Open in MD Reader",
        "icon": "$(book)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.openNewColumn",
        "title": "Open in MD Reader (New Column)",
        "icon": "$(split-horizontal)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.toggleTOC",
        "title": "Toggle Table of Contents",
        "icon": "$(list-tree)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.toggleSettings",
        "title": "MD Reader Settings",
        "icon": "$(gear)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.refresh",
        "title": "Refresh Reader",
        "icon": "$(refresh)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.refreshAll",
        "title": "Refresh All Reader Panels",
        "icon": "$(sync)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.find",
        "title": "Find in MD Reader",
        "icon": "$(search)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.exportPdf",
        "title": "Export as PDF...",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.exportHtml",
        "title": "Export as HTML...",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.showShortcuts",
        "title": "Show Keyboard Shortcuts",
        "icon": "$(question)",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.exportThemes",
        "title": "Export Themes...",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.importThemes",
        "title": "Import Themes...",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.addStarterThemes",
        "title": "Add Starter Themes to My Themes...",
        "category": "MD Reader"
      },
      {
        "command": "mdReader.deleteAllThemes",
        "title": "Delete All Custom Themes...",
        "category": "MD Reader"
      }
    ],
    "keybindings": [
      {
        "command": "mdReader.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'mdReaderPanel'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdReader.find",
          "when": "activeWebviewPanelId == 'mdReaderPanel'",
          "group": "navigation@1"
        },
        {
          "command": "mdReader.toggleTOC",
          "when": "activeWebviewPanelId == 'mdReaderPanel'",
          "group": "navigation@2"
        },
        {
          "command": "mdReader.toggleSettings",
          "when": "activeWebviewPanelId == 'mdReaderPanel'",
          "group": "navigation@3"
        },
        {
          "command": "mdReader.refresh",
          "when": "activeWebviewPanelId == 'mdReaderPanel'",
          "group": "navigation@8"
        },
        {
          "command": "mdReader.showShortcuts",
          "when": "activeWebviewPanelId == 'mdReaderPanel'",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdReader.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdReader.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mdReader.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MD Reader",
      "properties": {
        "mdReader.theme": {
          "default": "auto",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "auto",
                "light",
                "dark",
                "sepia"
              ],
              "enumDescriptions": [
                "Follow VS Code's color theme",
                "Light reading theme",
                "Dark reading theme",
                "Warm sepia reading theme"
              ]
            },
            {
              "type": "string",
              "pattern": "^(custom|starter):[a-z0-9][a-z0-9-]{0,39}$",
              "description": "One of your own themes (custom:<id>) or a bundled starter theme (starter:<id>)."
            }
          ],
          "description": "Color theme for the reader panel: a built-in theme, custom:<id> for one you created (see mdReader.customThemes), or starter:<id> for a bundled starter theme. An unknown or deleted theme falls back to Auto."
        },
        "mdReader.customThemes": {
          "type": "object",
          "default": {},
          "markdownDescription": "Your own reader themes, keyed by id. Normally created and edited from the reader's Settings drawer (**Customize theme**). A theme stores a `base` (`light`, `dark` or `sepia`) plus only the colors you changed; anything unset comes from the base. Stored in user settings, so it survives extension updates and reinstalls. Use **MD Reader: Export Themes** / **Import Themes** to back up or share.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "base"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "author": {
                "type": "string",
                "maxLength": 60
              },
              "from": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
                "description": "Id of a starter theme this theme tweaks. Only the colors you changed are stored; the rest follows the starter."
              },
              "base": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "sepia"
                ]
              },
              "colors": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bg": {
                    "type": "string",
                    "format": "color",
                    "description": "CSS color: #rgb, #rrggbb, #rrggbbaa, rgb()/hsl()."
                  },
                  "bgAlt": {
                    "type": "string",
                    "format": "color",
                    "description": "CSS color: #rgb, #rrggbb, #rrggbbaa, rgb()/hsl()."
                  },
                  "surface": {
                    "type": "string",
                    "format": "color",
