        "mdReader.fontFamily": {
          "type": "string",
          "default": "Georgia, 'Times New Roman', serif",
          "description": "Body font family for reading content."
        },
        "mdReader.fontSize": {
          "type": "number",
          "default": 17,
          "minimum": 10,
          "maximum": 72,
          "description": "Base font size in pixels."
        },
        "mdReader.lineHeight": {
          "type": "number",
          "default": 1.85,
          "minimum": 1.2,
          "maximum": 3,
          "description": "Line height multiplier for body text."
        },
        "mdReader.readingWidth": {
          "type": "string",
          "default": "medium",
          "enum": [
            "narrow",
            "medium",
            "wide",
            "wider",
            "ultra",
            "full"
          ],
          "enumDescriptions": [
            "Narrow column (640px) — focused reading",
            "Medium column (760px) — balanced default",
            "Wide column (960px) — more content visible",
            "Wider column (1100px) — for large monitors",
            "Ultra column (1400px) — maximum fixed width",
            "Full window width (100%) — no side margins"
          ],
          "description": "Width of the reading column."
        },
        "mdReader.layout": {
          "type": "string",
          "default": "standard",
          "enum": [
            "standard",
            "compact",
            "book",
            "editorial",
            "magazine",
            "academic"
          ],
          "enumDescriptions": [
            "Standard — the default look",
            "Compact — tighter headings and paragraphs",
            "Book — serif headings, indented paragraphs, no rules",
            "Editorial — strong hierarchy with a heavy rule under the title",
            "Magazine — large bold sans-serif headings",
            "Academic — serif headings, restrained scale, no rules"
          ],
          "description": "Typography of headings and paragraphs (font, scale, spacing, rules), independent of the colour theme. Body font, size, line height and width stay your own settings. Layouts are files in the extension's layouts/ folder."
        },
        "mdReader.codeTheme": {
          "type": "string",
          "default": "github-dark",
          "enum": [
            "github-dark",
            "github-light",
            "monokai",
            "atom-one-dark",
            "vs2015"
          ],
          "description": "Syntax-highlighting palette for code blocks. A theme that defines its own syntax colors (see mdReader.customThemes) overrides this. github-light also lightens the code block background."
        },
        "mdReader.blueLightFilter": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Opacity percentage (0-100) of the warm amber Eye Care overlay. 0 = Off."
        },
        "mdReader.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the reader when the file is saved."
        },
        "mdReader.scrollSync": {
          "type": "boolean",
          "default": false,
          "description": "Synchronize scroll position between the editor and reader panel."
        },
        "mdReader.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open the reader beside the editor (split view). Set to false to open in a new full-width column."
        },
        "mdReader.export.embedImages": {
          "type": "boolean",
          "default": true,
          "description": "When exporting as HTML, embed local images as base64 data URIs so the exported file is self-contained. Remote (http/https) images are always left as links."
        },
        "mdReader.showReadingTime": {
          "type": "boolean",
          "default": true,
          "description": "Show an estimated reading time and word count in the corner of the reader panel."
        },
        "mdReader.readingSpeed": {
          "type": "number",
          "default": 230,
          "minimum": 50,
          "maximum": 1000,
          "description": "Words per minute used to estimate reading time."
        },
        "mdReader.customCssPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a CSS file loaded after the reader's own stylesheet, for personal style overrides. Leave empty to disable. Takes effect the next time a reader panel is opened."
        },
        "mdReader.frontMatter": {
          "type": "string",
          "default": "card",
          "enum": [
            "card",
            "hide",
            "raw"
          ],
          "enumDescriptions": [
            "Show a metadata card (title, author, date, tags, ...) above the content",
            "Strip the front matter block silently",
            "Show the front matter as an ordinary (syntax-highlighted) code block instead of interpreting it"
          ],
          "description": "How to handle a leading --- YAML front matter block."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "copy-assets": "node scripts/copy-vendor-assets.js",
    "build": "npm run copy-assets && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "tsc -p ./ --noEmit",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "test": "node scripts/run-tests.js"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "ovsx": "^1.3.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@viz-js/viz": "^3.31.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.7",
    "marked": "^11.1.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.17.2"
  }
}
