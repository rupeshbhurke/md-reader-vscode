{
  "mdReaderLayout": 1,
  "id": "editorial",
  "label": "Editorial",
  "author": "MD Reader starter pack",
  "version": "1.0.0",
  "headings": {
    "font": "Georgia, 'Times New Roman', serif",
    "weight": 700,
    "lineHeight": 1.2,
    "spaceBefore": 2.2,
    "spaceAfter": 0.5,
    "scale": {
      "h1": 2.4,
      "h2": 1.7,
      "h3": 1.3,
      "h4": 1.1,
      "h5": 1,
      "h6": 0.9
    },
    "rules": {
      "h1": 3,
      "h2": 0
    }
  },
  "paragraphs": {
    "space": 1.2,
    "indent": 0
  }
}
