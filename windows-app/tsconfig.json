{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-electron"
  },
  "include": ["electron/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
