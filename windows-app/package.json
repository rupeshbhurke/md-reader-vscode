{
  "name": "md-reader-windows",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "description": "Standalone Windows 11 Markdown Reader",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "marked": "^11.1.0",
    "highlight.js": "^11.9.0",
    "marked-gfm-heading-id": "^3.1.3"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.mdreader.windows",
    "productName": "MD Reader",
    "win": {
      "target": "nsis"
    }
  }
}
